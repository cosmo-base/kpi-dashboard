# ローカル開発用（.env.local にコピーして使う）
# KPI ダッシュボードの GAS（…/exec）と、Google ログインのクライアントID（FSIF Portal と同じ。
# 承認済みの JavaScript 生成元に http://localhost:3000 を足すとローカルでもログインできる）
NEXT_PUBLIC_KPI_GAS_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# CSV の URL は画面には埋め込まない。GitHub Secrets の NEXT_PUBLIC_KPI_◯◯_CSV_URL がデプロイ時に GAS へ送られる
